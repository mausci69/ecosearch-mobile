{
  "name": "ecosearch-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "dev:lan": "cross-env EXPO_PUBLIC_API_BASE_URL=http://192.168.1.112:8000 expo start --lan",
    "dev:tunnel": "cross-env EXPO_PUBLIC_API_BASE_URL=http://192.168.1.112:8000 expo start --tunnel"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "expo": "~54.0.10",
    "expo-image-manipulator": "~14.0.7",
    "expo-image-picker": "~17.0.8",
    "expo-status-bar": "^3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "cross-env": "^7.0.3",
    "eslint": "^9.10.0",
    "eslint-config-expo": "^10.0.0",
    "typescript": "^5.5.4"
  }
}
